# 103 课件演示公网中继：CN同事 -> 汤圆公网IP -> tailnet -> 家里PC
server {
    listen 8861;
    server_name _;
    client_max_body_size 300m;
    location / {
        proxy_pass http://100.84.28.40:8861;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
server {
    listen 8862;
    server_name _;
    client_max_body_size 300m;
    # Phase AI1 课后问答后端（家里PC 8863，无状态）
    location /api/ {
        proxy_pass http://100.84.28.40:8863;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 160s;
    }
    location / {
        proxy_pass http://100.84.28.40:8862;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
